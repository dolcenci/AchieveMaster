<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_gradient_primary"
        android:padding="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/create_new_goal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/goal_title"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/etGoalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/goal_title"
                android:padding="14dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="16dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:id="@+id/tvDescriptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/goal_description_optional"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/etGoalDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/goal_description_optional"
                android:padding="14dp"
                android:minLines="3"
                android:gravity="top"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="16dp"
                android:importantForAutofill="no"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/tvMuscleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/target_muscle_group"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerMuscle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvTargetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/target_exercises_count"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/etTargetExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g., 20"
                android:padding="14dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="24dp"
                android:importantForAutofill="no"
                android:inputType="number" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveGoal"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_goal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewGoals"
                style="@style/AppButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_my_goals"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>